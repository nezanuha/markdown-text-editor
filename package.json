{
  "name": "markdown-text-editor",
  "version": "2.0.0-beta.2",
  "type": "module",
  "description": "A markdown editor that enhances your textarea instead of replacing it, so form submission, validation and required fields keep working. WYSIWYG hybrid mode, live preview, find and replace, RTL, TypeScript types. Works with any backend.",
  "funding": "https://ko-fi.com/nezanuha",
  "main": "./dist/markdown-text-editor.umd.js",
  "module": "./dist/markdown-text-editor.es.js",
  "browser": "./dist/markdown-text-editor.min.js",
  "unpkg": "./dist/markdown-text-editor.min.js",
  "jsdelivr": "./dist/markdown-text-editor.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/markdown-text-editor.es.js",
      "require": "./dist/markdown-text-editor.umd.js",
      "default": "./dist/markdown-text-editor.umd.js"
    },
    "./style.css": "./dist/markdown-text-editor.css",
    "./locale/*.js": {
      "types": "./locale/locale.d.ts",
      "default": "./locale/*.js"
    },
    "./locale/*": {
      "types": "./locale/locale.d.ts",
      "default": "./locale/*.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "types/",
    "locale/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nezanuha/markdown-text-editor.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "locale:extract": "node scripts/locale-extract.mjs",
    "locale:check": "node scripts/locale-check.mjs",
    "version": "node scripts/check-changelog.mjs",
    "postversion": "git push origin HEAD --follow-tags",
    "test": "node test/smoke.mjs && node scripts/locale-check.mjs",
    "typecheck": "tsc --noEmit --strict --lib es2020,dom --moduleResolution bundler --module esnext test/types.test.ts"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "keywords": [
    "markdown",
    "markdown editor",
    "wysiwyg",
    "wysiwyg markdown",
    "textarea markdown editor",
    "embeddable markdown editor",
    "markdown preview",
    "rich text editor",
    "text editor",
    "markdown plugin",
    "rtl",
    "rtl markdown",
    "dark mode",
    "find and replace",
    "django markdown",
    "laravel markdown",
    "csp compatible",
    "form markdown editor",
    "live preview",
    "mde",
    "typescript",
    "markdown-it",
    "template editor",
    "merge tags",
    "placeholders"
  ],
  "author": "Nezanuha",
  "license": "MIT",
  "homepage": "https://frutjam.com/plugins/markdown-editor",
  "bugs": {
    "url": "https://github.com/nezanuha/markdown-text-editor/issues"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "~18.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "diff": "^9.0.0",
    "frutjam": "^2.3.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "types": "./types/index.d.ts",
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
